# Copie para .env e preencha. O arquivo .env nao e versionado.

# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# 1 durante o desenvolvimento, 0 em producao
DJANGO_DEBUG=1

# Separados por virgula. Obrigatorio quando DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=

# Chave da API transacional do Brevo. Obrigatoria: a aplicacao nao sobe sem ela.
BREVO_API_KEY=

# Precisa ser um remetente verificado na conta do Brevo
EMAIL_REMETENTE=DataCampus <noreply@alunos.umc.br>

# Identificação e canal público para informações LGPD/termos. Preencher com dados oficiais.
LGPD_CONTROLADOR_NOME=
LGPD_CONTATO=
LGPD_ENCARREGADO=

# Chaves separadas para cifrar dados de voluntários e gerar identificadores HMAC.
# Gere a chave Fernet com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Gere a chave HMAC com: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATACAMPUS_FERNET_KEY=
DATACAMPUS_HMAC_KEY=
